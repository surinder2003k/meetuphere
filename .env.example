# WebRTC TURN relay configuration (calls fail behind strict NAT/firewalls without one).
# Defaults to the free Metered OpenRelay public TURN server. Override these with
# your own coturn / Cloudflare Turn deployment for production use.
#
# Comma-separate multiple URLs if needed.
NEXT_PUBLIC_STUN_URLS=
NEXT_PUBLIC_TURN_URL=turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443,turn:openrelay.metered.ca:443?transport=tcp
NEXT_PUBLIC_TURN_USERNAME=openrelayproject
NEXT_PUBLIC_TURN_CREDENTIAL=openrelayproject

# Signaling server URL the client connects to (only used outside localhost dev).
# NEXT_PUBLIC_SERVER_URL=https://your-socket-server.onrender.com
