{
  "name": "meetuphere",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "set NEXT_PUBLIC_SERVER_URL=http://localhost:3001&& concurrently \"next dev\" \"tsx watch server/index.ts\"",
    "dev:client": "next dev",
    "dev:server": "tsx watch server/index.ts",
    "build": "next build",
    "start": "set NODE_ENV=production&& tsx server/custom.ts",
    "start:dev": "next start",
    "lint": "eslint",
    "server": "tsx server/index.ts",
    "test:server": "tsx scripts/signaling.test.ts"
  },
  "dependencies": {
